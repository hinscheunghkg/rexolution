// --- CUSTOM CHART ---
const YieldChart = ({ data, pmsScore, isPreMarket }) => {
  const width = 800; const height = 300; const padding = 20;
  if (!data || data.length === 0) return null;
  const maxPrice = Math.max(...data.map(d => d.ceiling)) * 1.1; const minPrice = 0;
  const xScale = (index) => (index / (data.length - 1)) * (width - 2 * padding) + padding;
  const yScale = (price) => height - padding - ((price - minPrice) / (maxPrice - minPrice)) * (height - 2 * padding);
  const floorPoints = data.map((d, i) => `${xScale(i)},${yScale(d.floor)}`).join(' ');
  const ceilingPoints = data.map((d, i) => `${xScale(i)},${yScale(d.ceiling)}`).join(' ');
  const areaPoints = [...data.map((d, i) => `${xScale(i)},${yScale(d.ceiling)}`), ...data.slice().reverse().map((d, i) => `${xScale(data.length - 1 - i)},${yScale(d.floor)}`)].join(' ');
  const lastIdx = data.length - 1; const lastX = xScale(lastIdx);
  const currentFloor = data[lastIdx].floor; const currentCeiling = data[lastIdx].ceiling;
  const userPrice = currentFloor + (currentCeiling - currentFloor) * (pmsScore / 100);
  const lastY = yScale(userPrice); const dotColor = pmsScore > 80 ? '#fbbf24' : pmsScore > 40 ? '#22d3ee' : '#e2e8f0';

  return (
    <div className="w-full h-[300px] bg-slate-900/50 rounded-xl border border-slate-800 relative overflow-hidden shadow-inner group">
      <div className="absolute top-4 left-4 z-10 bg-slate-900/80 px-3 py-1 rounded-full border border-slate-700 backdrop-blur-sm"><h3 className="text-slate-300 text-xs font-mono flex items-center gap-2">{isPreMarket ? <Clock size={14} className="text-orange-400"/> : <TrendingUp size={14} className="text-emerald-400"/>}{isPreMarket ? "PROJECTED YIELD (LOCKED)" : "LIVE YIELD CHANNEL"}</h3></div>
      {isPreMarket && <div className="absolute inset-0 bg-slate-950/60 z-0 flex items-center justify-center pointer-events-none"><div className="bg-slate-900/90 border border-slate-700 p-4 rounded-xl backdrop-blur-md flex flex-col items-center"><Lock className="text-slate-400 mb-2" size={24}/><span className="text-slate-200 font-bold tracking-widest text-sm">MARKET OPENS IN 14:02:55</span></div></div>}
      <svg width="100%" height="100%" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" className="overflow-visible relative z-10">
        <defs><linearGradient id="goldGradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#fbbf24" stopOpacity={isPreMarket ? 0.1 : 0.2} /><stop offset="100%" stopColor="#fbbf24" stopOpacity="0" /></linearGradient></defs>
        <path d={`M ${areaPoints} Z`} fill="url(#goldGradient)" opacity="0.4" />
        <polyline points={ceilingPoints} fill="none" stroke="#fbbf24" strokeWidth="2" strokeDasharray={isPreMarket ? "4 4" : "0"} strokeOpacity="0.8" />
        <polyline points={floorPoints} fill="none" stroke="#e2e8f0" strokeWidth="1.5" strokeDasharray="4 4" strokeOpacity="0.5" />
        <line x1={padding} y1={yScale(data[0].floor + (data[0].ceiling - data[0].floor) * (pmsScore / 100))} x2={lastX} y2={lastY} stroke={dotColor} strokeWidth="1" strokeDasharray="2 2" opacity="0.5" />
        <circle cx={lastX} cy={lastY} r="6" fill={dotColor} stroke="white" strokeWidth="2">{!isPreMarket && <animate attributeName="r" values="6;10;6" dur="2s" repeatCount="indefinite" />}</circle>
        <text x={width-padding} y={yScale(currentCeiling) - 10} fill="#fbbf24" fontSize="10" textAnchor="end">MAX (PMS 100)</text><text x={width-padding} y={yScale(currentFloor) + 15} fill="#94a3b8" fontSize="10" textAnchor="end">FLOOR (PMS 0)</text>
      </svg>
    </div>
  );
};

// --- DATA LOGIC ---
const generateChartData = (tick, isPreMarket) => {
  const data = [];
  for (let i = 0; i < 50; i++) {
    const time = i + tick;
    const base = isPreMarket ? 10 : 10 + Math.sin(time * 0.1) * 2 + (time * 0.05);
    data.push({ time, floor: parseFloat(Math.max(base, 2).toFixed(2)), ceiling: parseFloat((base * MAX_MULTIPLIER).toFixed(2)) });
  }
  return data;
};

