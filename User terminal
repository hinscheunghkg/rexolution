                </div>
                <div className="border-t border-slate-700 pt-4 mt-auto"><div className="flex justify-between items-end mb-4"><span className="text-xs text-slate-400 font-bold">PAYOUT</span><span className="text-xl font-mono font-bold text-white">${orderValue.toFixed(2)}</span></div>
                  {txState === 'SUCCESS' ? (<div className="w-full py-3 bg-emerald-500/20 border border-emerald-500 text-emerald-400 rounded-lg flex items-center justify-center gap-2 font-bold text-sm animate-in fade-in zoom-in"><CheckCircle2 size={18} /> TRADE SETTLED</div>) : (<button onClick={handleAtomicTrade} disabled={selectedTasks.length === 0 || txState === 'PROCESSING'} className={`w-full py-3 rounded-lg font-bold text-sm tracking-wide shadow-lg shadow-emerald-900/20 transition-all flex items-center justify-center gap-2 ${selectedTasks.length === 0 ? 'bg-slate-800 text-slate-500 cursor-not-allowed' : 'bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-900 transform active:scale-95'}`}>{txState === 'PROCESSING' ? <span className="animate-pulse">VERIFYING...</span> : <>VERIFY & SELL INTENT <ArrowRight size={16}/></>}</button>)}
                </div>
              </div>
              {/* 2. LIQUIDITY GAUGE */}
              <div className="bg-slate-900 border border-slate-700 rounded-xl p-4 shadow-lg relative overflow-hidden"><div className="flex justify-between items-center mb-2 z-10 relative"><h3 className="text-slate-300 text-xs font-bold uppercase flex items-center gap-2"><Droplet size={14} className={poolPercentage < 20 ? "text-red-500" : "text-blue-400"} /> Pool Liquidity</h3><span className={`font-mono text-[10px] ${poolPercentage < 20 ? "text-red-500 font-bold animate-pulse" : "text-slate-400"}`}>{poolPercentage < 20 ? "DRAINING FAST" : "HEALTHY"}</span></div><div className="relative w-full h-3 bg-slate-800 rounded-full overflow-hidden mb-1 z-10"><div className={`h-full transition-all duration-500 ${poolPercentage < 20 ? 'bg-red-500' : 'bg-blue-500'}`} style={{ width: `${poolPercentage}%` }}></div></div><div className="flex justify-between text-[10px] font-mono text-white z-10 relative"><span>${poolLiquidity.toLocaleString()}</span><span className="text-slate-500">/ ${INITIAL_POOL_SIZE.toLocaleString()}</span></div></div>
              {/* 3. ORDER BOOK */}
              <div className="h-64 animate-in slide-in-from-right duration-500"><OrderBook currentPrice={currentPrice} pmsScore={pmsScore} /></div>
            </>
          )}
        </div>
      </div>
    </div>
  );
};

export default RexolutionTerminalV2;
