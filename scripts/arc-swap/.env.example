# Copy to .env and fill in. Never commit .env.

# Arc mainnet JSON-RPC endpoint (QuickNode/Alchemy/your own node/public RPC from docs.arc.io)
ARC_RPC_URL=https://YOUR-ARC-MAINNET-RPC

# Private key of the wallet that holds USDC on Arc (0x-prefixed, 32 bytes)
PRIVATE_KEY=0x...

# ---- Optional: pool discovery ----
# If auto-discovery is slow on your RPC, give the block where the token was launched
# (look up the token's creation tx on Arcscan). Scanning starts there.
# POOL_FROM_BLOCK=2000000
# How many blocks per eth_getLogs request (lower if your RPC rejects big ranges)
# LOG_CHUNK=20000

# ---- Optional: manual PoolKey (skips discovery). All four are required together. ----
# QUOTE = "native" for native USDC (address(0), 18 decimals) or the 6-decimal ERC-20 predeploy
# QUOTE=0x3600000000000000000000000000000000000000
# HOOK=0x...
# FEE=10000
# TICK_SPACING=200

# ---- Optional: bytes passed to the hook on every swap (default 0x) ----
# HOOK_DATA=0x
